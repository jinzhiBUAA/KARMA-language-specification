                  <buttons labelExpression="取消" closeDialogOnClick="true" rollbackChangesOnClose="true"/>
                  <buttons labelExpression="确定" default="true" closeDialogOnClick="true"/>
                  <page name="GanttTaskPage" labelExpression="任务" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.8/@controls.0/@onClickOperation/@firstModelOperations/@subModelOperations.0/@subModelOperations.0/@groups.0"/>
