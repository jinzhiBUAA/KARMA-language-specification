                        </firstModelOperations>
                      </initialOperation>
                    </controls>
                    <controls xsi:type="properties-ext-widgets-reference:ExtReferenceDescription" name="ganttTaskElementsRef" labelExpression="任务事件" referenceNameExpression="ganttTaskElements" referenceOwnerExpression="var:self">
                      <onClickOperation>
                        <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:selection->at(1)">
                          <subModelOperations xsi:type="tool_1:If" conditionExpression="aql:onClickEventKind='DOUBLE_CLICK'">
                            <subModelOperations xsi:type="properties:DialogModelOperation" titleExpression="属性设置">
                              <buttons labelExpression="取消" closeDialogOnClick="true" rollbackChangesOnClose="true"/>
                              <buttons labelExpression="确定" default="true" closeDialogOnClick="true"/>
                              <page name="GanttTaskElement" labelExpression="" semanticCandidateExpression="var:self" groups="//@extensions.0/@categories.0/@groups.8/@controls.0/@onClickOperation/@firstModelOperations/@subModelOperations.0/@subModelOperations.0/@groups.0/@controls.3/@onClickOperation/@firstModelOperations/@subModelOperations.0/@subModelOperations.0/@groups.0"/>
                              <groups name="GanttTaskElementGroup" labelExpression="默认属性" semanticCandidateExpression="var:self">
                                <controls xsi:type="properties:LabelDescription" labelExpression="元模型信息" valueExpression="service:getMetaInfo()"/>
                                <controls xsi:type="properties:LabelDescription" name="idLabel" labelExpression="id" valueExpression="service:getGanttTaskElementId()"/>
                                <controls xsi:type="properties:TextDescription" name="nameText" labelExpression="标签" valueExpression="aql:self.name">
                                  <initialOperation>
                                    <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="var:self">
                                      <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="aql:self.setValue(newValue)"/>
                                    </firstModelOperations>
