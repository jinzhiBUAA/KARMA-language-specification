      <groups name="ganttTaskGroup" labelExpression="任务" domainClass="Gantt" semanticCandidateExpression="var:self">
        <controls xsi:type="properties-ext-widgets-reference:ExtReferenceDescription" labelExpression="任务" referenceNameExpression="ganttTasks" referenceOwnerExpression="var:self">
          <onClickOperation>
            <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:selection->at(1)">
              <subModelOperations xsi:type="tool_1:If" conditionExpression="aql:onClickEventKind='DOUBLE_CLICK'">
