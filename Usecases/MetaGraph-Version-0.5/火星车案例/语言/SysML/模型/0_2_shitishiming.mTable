<?xml version="1.0" encoding="UTF-8"?>
<KARMA_external_plugin>
  <Mapping_Table Name="0_2_shitishiming" localLabel="0_2_实体使命映射">
    <THE-HEADER>
      <ROW-HEADER><ROW id="_XlJNoOnWEe-P0udKvD5Ccw">1.依据火星探索使命规划给出毅力号设计方案</ROW><ROW id="_q8O-IOnWEe-P0udKvD5Ccw">2.依据设计书完成生产制造</ROW><ROW id="_0GhjcOnWEe-P0udKvD5Ccw">3.在地面实验室模拟火星车全部工作环境，确保能够在太空和火星完成工作</ROW><ROW id="_CRB6UOnXEe-P0udKvD5Ccw">4.保证火星车发射成功</ROW><ROW id="_8hnZEOnZEe-P0udKvD5Ccw">5.监测维护航天器和火星车在太空运行状态直至火星</ROW><ROW id="_QHfMcOnaEe-P0udKvD5Ccw">6.指挥火星车降落，采集降落过程中的数据</ROW><ROW id="_nHaE0OnaEe-P0udKvD5Ccw">7.通过火星车研究火星地表岩层、矿物质、研究对应地区的空气状况、气候、环境变化历史。</ROW><ROW id="_n7vr0OnaEe-P0udKvD5Ccw">8.确定研究地区是否能满足生命生存或存在过生命存在遗迹</ROW><ROW id="_oM2p8OnaEe-P0udKvD5Ccw">9.采集分析样本，并将样本保存在标记位置，以便未来可能的取回</ROW><ROW id="_ofGQgOnaEe-P0udKvD5Ccw">10.进行飞行与制氧试验，为未来探测计划提供参考</ROW></ROW-HEADER>
      <COLUMN-HEADER><COLUMN id="_f1muUOneEe-P0udKvD5Ccw">美国政府</COLUMN><COLUMN id="_AQHuWuneEe-P0udKvD5Ccw">NASA</COLUMN><COLUMN id="_gF_TsOneEe-P0udKvD5Ccw">JPL实验室
</COLUMN><COLUMN id="_gYG-cOneEe-P0udKvD5Ccw">科学研究团队
</COLUMN><COLUMN id="_g48aoOneEe-P0udKvD5Ccw">空气动力实验室
</COLUMN><COLUMN id="_gqDqEOneEe-P0udKvD5Ccw">肯尼迪航天中心
</COLUMN><COLUMN id="_hUtJkOneEe-P0udKvD5Ccw">毅力号
</COLUMN><COLUMN id="_hHcwsOneEe-P0udKvD5Ccw">运载火箭
</COLUMN><COLUMN id="_hkdc0OneEe-P0udKvD5Ccw">火星2020航天器
</COLUMN><COLUMN id="_oq1CkOneEe-P0udKvD5Ccw">雷达和摄像系统
</COLUMN><COLUMN id="_odhmYOneEe-P0udKvD5Ccw">火星勘测轨道飞行器
</COLUMN><COLUMN id="_t_mu4OneEe-P0udKvD5Ccw">岩石化学扫描仪
</COLUMN><COLUMN id="_xqTfAOneEe-P0udKvD5Ccw">录音设备
</COLUMN><COLUMN id="_xcXJoOneEe-P0udKvD5Ccw">钻孔取芯机构
</COLUMN><COLUMN id="_o5kpMOneEe-P0udKvD5Ccw">Ingenuity直升机
</COLUMN><COLUMN id="_oP-5oOneEe-P0udKvD5Ccw">地形相对导航系统
</COLUMN><COLUMN id="_pFqkcOneEe-P0udKvD5Ccw">环境矿物扫描分析仪
</COLUMN><COLUMN id="_tw9O4OneEe-P0udKvD5Ccw">地形传感器
</COLUMN></COLUMN-HEADER>
    </THE-HEADER>
    <LINK><row id="_XlJNoOnWEe-P0udKvD5Ccw"><column id="_f1muUOneEe-P0udKvD5Ccw"/><column id="_AQHuWuneEe-P0udKvD5Ccw">追溯</column><column id="_gF_TsOneEe-P0udKvD5Ccw"/><column id="_gYG-cOneEe-P0udKvD5Ccw"/><column id="_g48aoOneEe-P0udKvD5Ccw"/><column id="_gqDqEOneEe-P0udKvD5Ccw"/><column id="_hUtJkOneEe-P0udKvD5Ccw">追溯</column><column id="_hHcwsOneEe-P0udKvD5Ccw"/><column id="_hkdc0OneEe-P0udKvD5Ccw"/><column id="_oq1CkOneEe-P0udKvD5Ccw"/><column id="_odhmYOneEe-P0udKvD5Ccw"/><column id="_t_mu4OneEe-P0udKvD5Ccw"/><column id="_xqTfAOneEe-P0udKvD5Ccw"/><column id="_xcXJoOneEe-P0udKvD5Ccw"/><column id="_o5kpMOneEe-P0udKvD5Ccw"/><column id="_oP-5oOneEe-P0udKvD5Ccw"/><column id="_pFqkcOneEe-P0udKvD5Ccw"/><column id="_tw9O4OneEe-P0udKvD5Ccw"/></row><row id="_q8O-IOnWEe-P0udKvD5Ccw"><column id="_f1muUOneEe-P0udKvD5Ccw"/><column id="_AQHuWuneEe-P0udKvD5Ccw">追溯</column><column id="_gF_TsOneEe-P0udKvD5Ccw"/><column id="_gYG-cOneEe-P0udKvD5Ccw"/><column id="_g48aoOneEe-P0udKvD5Ccw"/><column id="_gqDqEOneEe-P0udKvD5Ccw"/><column id="_hUtJkOneEe-P0udKvD5Ccw">追溯</column><column id="_hHcwsOneEe-P0udKvD5Ccw"/><column id="_hkdc0OneEe-P0udKvD5Ccw"/><column id="_oq1CkOneEe-P0udKvD5Ccw"/><column id="_odhmYOneEe-P0udKvD5Ccw"/><column id="_t_mu4OneEe-P0udKvD5Ccw"/><column id="_xqTfAOneEe-P0udKvD5Ccw"/><column id="_xcXJoOneEe-P0udKvD5Ccw"/><column id="_o5kpMOneEe-P0udKvD5Ccw"/><column id="_oP-5oOneEe-P0udKvD5Ccw"/><column id="_pFqkcOneEe-P0udKvD5Ccw"/><column id="_tw9O4OneEe-P0udKvD5Ccw"/></row><row id="_0GhjcOnWEe-P0udKvD5Ccw"><column id="_f1muUOneEe-P0udKvD5Ccw"/><column id="_AQHuWuneEe-P0udKvD5Ccw">追溯</column><column id="_gF_TsOneEe-P0udKvD5Ccw"/><column id="_gYG-cOneEe-P0udKvD5Ccw"/><column id="_g48aoOneEe-P0udKvD5Ccw">追溯</column><column id="_gqDqEOneEe-P0udKvD5Ccw"/><column id="_hUtJkOneEe-P0udKvD5Ccw">追溯</column><column id="_hHcwsOneEe-P0udKvD5Ccw"/><column id="_hkdc0OneEe-P0udKvD5Ccw"/><column id="_oq1CkOneEe-P0udKvD5Ccw"/><column id="_odhmYOneEe-P0udKvD5Ccw"/><column id="_t_mu4On